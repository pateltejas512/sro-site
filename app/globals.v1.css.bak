/* SRO design system — one stylesheet, no framework, ~12 KB gzipped budget. */
:root {
  --bg: #f6f7fb;
  --surface: #ffffff;
  --surface-2: #f1f3f9;
  --line: #e4e7f0;
  --line-strong: #cfd5e3;
  --ink: #0f172a;
  --ink-2: #3b4559;
  --muted: #5a6478;
  --brand: #2f54eb;
  --brand-600: #2443c9;
  --brand-50: #eef2ff;
  --brand-100: #dfe6ff;
  --navy: #0b1a4a;
  --navy-2: #172f7a;
  --gold: #f5a524;
  --gold-50: #fff6e5;
  --good: #0d8a42;
  --good-50: #e8f8ef;
  --bad: #cf3438;
  --bad-50: #fdecec;
  --warn: #b7791f;
  --warn-50: #fff8e6;
  --violet: #7c3aed;
  --radius: 14px;
  --radius-sm: 10px;
  --shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 4px 16px rgba(16, 24, 40, 0.06);
  --shadow-lg: 0 10px 40px rgba(16, 24, 40, 0.12);
  --font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', 'Noto Sans Gujarati', 'Shruti', 'Noto Sans Devanagari', sans-serif;
  --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  --wrap: 1200px;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) {
    --bg: #0b1020;
    --surface: #121a2e;
    --surface-2: #18223a;
    --line: #243049;
    --line-strong: #33415f;
    --ink: #eef2fb;
    --ink-2: #c4cce0;
    --muted: #8d98b3;
    --brand: #6f8bff;
    --brand-600: #8ea4ff;
    --brand-50: #1a2550;
    --brand-100: #22306a;
    --gold-50: #2d2410;
    --good-50: #0f2a1d;
    --bad-50: #2f1517;
    --warn-50: #2b230f;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 4px 16px rgba(0, 0, 0, 0.25);
    color-scheme: dark;
  }
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: var(--font);
  font-size: 16px;
  line-height: 1.6;
  color: var(--ink);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
}
a { color: var(--brand); text-decoration: none; }
a:hover { text-decoration: underline; }
img, svg { max-width: 100%; }
h1, h2, h3, h4 { line-height: 1.25; margin: 0 0 0.5em; letter-spacing: -0.01em; }
h1 { font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem); font-weight: 800; }
h2 { font-size: clamp(1.2rem, 1rem + 0.8vw, 1.5rem); font-weight: 750; }
h3 { font-size: 1.05rem; font-weight: 700; }
p { margin: 0 0 1em; }
button { font: inherit; cursor: pointer; }
:focus-visible { outline: 3px solid var(--brand); outline-offset: 2px; border-radius: 6px; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 16px; }
.muted { color: var(--muted); }
.small { font-size: 0.875rem; }
.tiny { font-size: 0.78rem; }
.row { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.stack > * + * { margin-top: 16px; }
.grow { flex: 1; }

/* ---------- Header ---------- */
.skip { position: absolute; left: -999px; top: 8px; background: var(--brand); color: #fff; padding: 8px 12px; border-radius: 8px; z-index: 100; }
.skip:focus { left: 8px; }
.hdr { position: sticky; top: 0; z-index: 40; background: color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter: saturate(180%) blur(12px); border-bottom: 1px solid var(--line); }
.hdr-in { display: flex; align-items: center; gap: 16px; height: 64px; }
.logo { display: flex; align-items: center; gap: 10px; font-weight: 800; color: var(--ink); font-size: 1.05rem; }
.logo:hover { text-decoration: none; }
.logo-mark { width: 34px; height: 34px; border-radius: 10px; background: linear-gradient(135deg, var(--brand), var(--violet)); color: #fff; display: grid; place-items: center; font-size: 0.8rem; font-weight: 900; letter-spacing: 0.02em; }
.logo small { display: block; font-size: 0.68rem; font-weight: 600; color: var(--muted); letter-spacing: 0.02em; }
.nav { display: flex; gap: 4px; margin-left: 12px; }
.nav a { color: var(--ink-2); font-weight: 600; font-size: 0.93rem; padding: 8px 12px; border-radius: 10px; }
.nav a:hover { background: var(--surface-2); text-decoration: none; }
.nav a[aria-current='page'] { color: var(--brand); background: var(--brand-50); }
.hdr-search { margin-left: auto; display: flex; align-items: center; gap: 8px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; padding: 0 12px; height: 40px; width: min(320px, 32vw); color: var(--muted); }
.hdr-search input { border: 0; background: transparent; outline: none; font: inherit; color: var(--ink); width: 100%; font-size: 0.92rem; }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 42px; padding: 0 18px; border-radius: 12px; font-weight: 700; font-size: 0.93rem; border: 1px solid transparent; transition: transform 0.06s ease, background 0.15s ease, box-shadow 0.15s ease; white-space: nowrap; }
.btn:hover { text-decoration: none; }
.btn:active { transform: translateY(1px); }
.btn-primary { background: var(--brand); color: #fff; box-shadow: 0 6px 16px color-mix(in srgb, var(--brand) 30%, transparent); }
.btn-primary:hover { background: var(--brand-600); }
.btn-ghost { background: var(--surface); color: var(--ink); border-color: var(--line-strong); }
.btn-ghost:hover { background: var(--surface-2); }
.btn-soft { background: var(--brand-50); color: var(--brand); }
.btn-gold { background: var(--gold); color: #1d1300; }
.btn-sm { height: 34px; padding: 0 12px; font-size: 0.85rem; border-radius: 10px; }
.btn[aria-disabled='true'] { opacity: 0.5; pointer-events: none; }
@media (max-width: 900px) { .nav, .hdr-search { display: none; } .hdr-login { margin-left: auto; } }

/* Mobile bottom navigation (app feel) */
.bnav { display: none; }
@media (max-width: 900px) {
  body { padding-bottom: 68px; }
  .bnav { display: grid; grid-template-columns: repeat(5, 1fr); position: fixed; bottom: 0; left: 0; right: 0; z-index: 50; background: var(--surface); border-top: 1px solid var(--line); padding: 6px 4px calc(6px + env(safe-area-inset-bottom)); }
  .bnav a { display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 0.7rem; font-weight: 600; color: var(--muted); padding: 4px 0; }
  .bnav a:hover { text-decoration: none; }
  .bnav a[aria-current='page'] { color: var(--brand); }
  .bnav svg { width: 22px; height: 22px; }
}

/* ---------- Breadcrumb ---------- */
.crumbs { font-size: 0.82rem; color: var(--muted); padding: 14px 0 0; overflow-x: auto; white-space: nowrap; scrollbar-width: none; }
.crumbs ol { list-style: none; display: flex; gap: 6px; margin: 0; padding: 0; }
.crumbs li + li::before { content: '›'; margin-right: 6px; color: var(--line-strong); }
.crumbs a { color: var(--muted); }
.crumbs [aria-current] { color: var(--ink-2); font-weight: 600; }

/* ---------- Hero ---------- */
.hero { background: radial-gradient(1200px 400px at 85% -10%, rgba(124, 58, 237, 0.35), transparent 60%), linear-gradient(135deg, var(--navy), var(--navy-2)); color: #fff; border-radius: 22px; padding: clamp(22px, 4vw, 44px); margin-top: 16px; position: relative; overflow: hidden; }
.hero h1 { color: #fff; margin-bottom: 10px; }
.hero p { color: #c9d4ff; max-width: 640px; }
.hero .eyebrow { display: inline-flex; gap: 8px; align-items: center; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #ffd27a; background: rgba(255, 210, 122, 0.12); border: 1px solid rgba(255, 210, 122, 0.3); padding: 4px 10px; border-radius: 999px; margin-bottom: 14px; }
.hero-search { display: flex; gap: 8px; background: #fff; border-radius: 14px; padding: 6px; max-width: 620px; margin-top: 18px; box-shadow: var(--shadow-lg); }
.hero-search input { flex: 1; border: 0; outline: none; font: inherit; padding: 0 12px; color: #0f172a; min-width: 0; background: transparent; }
.hero-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-top: 26px; max-width: 720px; }
.hero-stats div { background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 14px; padding: 12px 14px; }
.hero-stats b { display: block; font-size: 1.35rem; color: #fff; line-height: 1.2; }
.hero-stats span { font-size: 0.78rem; color: #b9c6f5; }
@media (max-width: 640px) { .hero-stats { grid-template-columns: repeat(2, 1fr); } }

/* ---------- Sections & cards ---------- */
.section { margin-top: 36px; }
.section-head > * { min-width: 0; }
.section-head { display: flex; align-items: end; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.section-head h2 { margin: 0; }
.section-head p { margin: 2px 0 0; color: var(--muted); font-size: 0.92rem; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
.card-pad { padding: 18px; }
.grid { display: grid; gap: 14px; }
.g2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.g3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.g4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.g5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
@media (max-width: 1000px) { .g4, .g5 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 760px) { .g3, .g4, .g5 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .g2 { grid-template-columns: 1fr; } }

.tile { display: flex; flex-direction: column; gap: 6px; padding: 16px; color: var(--ink); transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s; }
.tile:hover { text-decoration: none; border-color: var(--brand); transform: translateY(-2px); box-shadow: var(--shadow-lg); }
.tile b { font-size: 0.98rem; }
.tile .muted { font-size: 0.82rem; }
.badge-ico { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; font-weight: 900; font-size: 0.72rem; letter-spacing: 0.02em; color: var(--brand); background: var(--brand-50); }
.badge-ico.c-gujarat { color: #c2410c; background: #fff1e7; }
.badge-ico.c-railway { color: #1d4ed8; background: #e8efff; }
.badge-ico.c-electricity { color: #a16207; background: #fff7dc; }
.badge-ico.c-engineering { color: #6d28d9; background: #f2ebff; }
.badge-ico.c-ssc { color: #0f766e; background: #e2f7f4; }

.chip { display: inline-flex; align-items: center; gap: 6px; font-size: 0.75rem; font-weight: 700; padding: 3px 9px; border-radius: 999px; background: var(--surface-2); color: var(--ink-2); border: 1px solid var(--line); white-space: nowrap; }
.chip.good { background: var(--good-50); color: var(--good); border-color: transparent; }
.chip.bad { background: var(--bad-50); color: var(--bad); border-color: transparent; }
.chip.warn { background: var(--warn-50); color: var(--warn); border-color: transparent; }
.chip.brand { background: var(--brand-50); color: var(--brand); border-color: transparent; }
.chip.gold { background: var(--gold-50); color: #9a6200; border-color: transparent; }

/* Paper card (Testbook-style, richer) */
.paper { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 16px 18px; }
.paper h3 { margin: 0 0 6px; font-size: 1rem; }
.paper h3 a { color: var(--ink); }
.facts { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 0.83rem; color: var(--muted); }
.facts span { display: inline-flex; gap: 6px; align-items: center; }
.paper-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
@media (max-width: 760px) { .paper { grid-template-columns: minmax(0, 1fr); } .chip { white-space: normal; } .paper-actions { justify-content: flex-start; } }
.progress { height: 6px; border-radius: 99px; background: var(--surface-2); overflow: hidden; margin-top: 10px; }
.progress i { display: block; height: 100%; background: linear-gradient(90deg, var(--brand), var(--violet)); border-radius: 99px; }

/* Layout with sidebar */
.layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 24px; align-items: start; }
.aside { position: sticky; top: 80px; display: grid; gap: 14px; }
@media (max-width: 1000px) { .layout { grid-template-columns: minmax(0, 1fr); } .aside { position: static; } }

/* Page header block */
.phead { padding: 22px; margin-top: 14px; display: grid; grid-template-columns: auto 1fr; gap: 18px; align-items: start; }
.phead .badge-ico { width: 60px; height: 60px; font-size: 0.85rem; border-radius: 16px; }
.phead h1 { margin-bottom: 8px; }
.phead p { color: var(--ink-2); margin-bottom: 12px; }
.kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-top: 6px; }
.kpis div { background: var(--surface-2); border-radius: 12px; padding: 10px 12px; }
.kpis b { display: block; font-size: 1.15rem; }
.kpis span { font-size: 0.75rem; color: var(--muted); }
@media (max-width: 640px) { .phead { grid-template-columns: 1fr; } .kpis { grid-template-columns: repeat(2, 1fr); } }

/* Tables */
.tbl { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
.tbl th, .tbl td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: middle; }
.tbl th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); font-weight: 700; background: var(--surface-2); }
.tbl tr:last-child td { border-bottom: 0; }
.bar { height: 8px; border-radius: 99px; background: var(--surface-2); min-width: 80px; }
.bar i { display: block; height: 100%; border-radius: 99px; background: var(--brand); }
.scroll-x { overflow-x: auto; }

/* Tabs / segmented */
.seg { display: inline-flex; background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; padding: 3px; gap: 2px; }
.seg button, .seg a { border: 0; background: transparent; padding: 6px 12px; border-radius: 9px; font-weight: 700; font-size: 0.85rem; color: var(--muted); }
.seg [aria-pressed='true'], .seg [aria-selected='true'] { background: var(--surface); color: var(--ink); box-shadow: var(--shadow); }

/* ---------- Question card ---------- */
.q { padding: 18px 20px; scroll-margin-top: 90px; }
.q-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
.q-no { font-weight: 800; color: var(--brand); background: var(--brand-50); border-radius: 8px; padding: 2px 9px; font-size: 0.85rem; }
.q-stem { font-size: 1.02rem; font-weight: 550; white-space: pre-line; margin-bottom: 14px; color: var(--ink); }
.q-stem.gu, .lang-gu { font-size: 1.06rem; line-height: 1.75; }
.opts { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
.opt { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; background: var(--surface); border: 1.5px solid var(--line); border-radius: 12px; padding: 11px 14px; color: var(--ink); font-size: 0.97rem; transition: border-color 0.12s, background 0.12s; }
button.opt:not(.is-correct):not(.is-wrong):hover { border-color: var(--brand); background: var(--brand-50); }
.opt .k { flex: 0 0 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; font-weight: 800; font-size: 0.82rem; background: var(--surface-2); color: var(--ink-2); }
.opt.is-correct { border-color: var(--good); background: var(--good-50); }
.opt.is-correct .k { background: var(--good); color: #fff; }
.opt.is-wrong { border-color: var(--bad); background: var(--bad-50); }
.opt.is-wrong .k { background: var(--bad); color: #fff; }
.opt.is-picked { border-color: var(--brand); background: var(--brand-50); }
.opt.is-picked .k { background: var(--brand); color: #fff; }
.opt .mark { margin-left: auto; font-weight: 800; font-size: 0.8rem; }
.sol { margin-top: 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface-2); }
.sol > summary { cursor: pointer; list-style: none; padding: 11px 14px; font-weight: 700; display: flex; align-items: center; gap: 8px; color: var(--ink-2); }
.sol > summary::-webkit-details-marker { display: none; }
.sol > summary::after { content: '▾'; margin-left: auto; transition: transform 0.15s; }
.sol[open] > summary::after { transform: rotate(180deg); }
.sol-body { padding: 0 14px 14px; }
.answer-line { display: flex; gap: 8px; align-items: center; font-weight: 700; color: var(--good); margin-bottom: 8px; }
.formula { font-family: var(--mono); font-size: 0.88rem; background: var(--surface); border: 1px dashed var(--line-strong); border-radius: 10px; padding: 10px 12px; margin: 10px 0; white-space: pre-line; }
.callout { display: flex; gap: 10px; border-radius: 10px; padding: 10px 12px; margin-top: 10px; font-size: 0.92rem; }
.callout.tip { background: var(--gold-50); }
.callout.note { background: var(--brand-50); }
.callout.warn { background: var(--warn-50); }
.detail h4 { font-size: 0.95rem; margin: 14px 0 4px; }
.detail p { margin: 0 0 8px; color: var(--ink-2); }
.q-foot { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 12px; font-size: 0.8rem; color: var(--muted); }
.q-foot a { font-weight: 600; }
.lang-switch { margin-left: auto; }

/* Paper toolbar */
.toolbar { position: sticky; top: 64px; z-index: 30; background: var(--bg); padding: 10px 0; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; border-bottom: 1px solid var(--line); margin-bottom: 14px; }
.score-pill { display: inline-flex; gap: 10px; align-items: center; font-weight: 700; font-size: 0.85rem; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; }
.score-pill .g { color: var(--good); }
.score-pill .r { color: var(--bad); }

/* CTA blocks */
.cta { background: linear-gradient(135deg, var(--brand), var(--violet)); color: #fff; border-radius: var(--radius); padding: 20px; }
.cta h3 { color: #fff; }
.cta p { color: #e3e8ff; font-size: 0.92rem; }
.cta .btn { background: #fff; color: var(--brand); }
.tg { background: linear-gradient(135deg, #229ed9, #1c7fc0); }

.list-plain { list-style: none; margin: 0; padding: 0; }
.list-plain li + li { border-top: 1px solid var(--line); }
.list-plain a { display: block; padding: 10px 0; color: var(--ink); font-size: 0.92rem; }
.list-plain a:hover { color: var(--brand); text-decoration: none; }

.faq details { border-bottom: 1px solid var(--line); padding: 12px 0; }
.faq summary { font-weight: 700; cursor: pointer; }
.faq p { margin: 8px 0 0; color: var(--ink-2); }

.notice { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border-radius: 12px; background: var(--warn-50); color: var(--ink-2); font-size: 0.9rem; border: 1px solid color-mix(in srgb, var(--warn) 25%, transparent); }

/* ---------- Footer ---------- */
.ftr { margin-top: 56px; border-top: 1px solid var(--line); background: var(--surface); padding: 32px 0 24px; font-size: 0.9rem; }
.ftr-grid { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: 24px; }
.ftr h4 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
.ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
.ftr a { color: var(--ink-2); }
@media (max-width: 760px) { .ftr-grid { grid-template-columns: 1fr 1fr; } }

/* ---------- CBT (Real exam mode) ---------- */
.cbt { position: fixed; inset: 0; z-index: 60; background: var(--bg); display: grid; grid-template-rows: auto 1fr auto; }
.cbt-top { display: flex; align-items: center; gap: 12px; padding: 10px 16px; background: var(--navy); color: #fff; }
.cbt-top .title { font-weight: 700; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.timer { margin-left: auto; font-family: var(--mono); font-weight: 800; background: rgba(255, 255, 255, 0.12); padding: 6px 12px; border-radius: 10px; font-size: 1rem; }
.timer.low { background: var(--bad); }
.cbt-body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; min-height: 0; }
.cbt-main { overflow-y: auto; padding: 18px; }
.cbt-side { border-left: 1px solid var(--line); background: var(--surface); overflow-y: auto; padding: 16px; }
.palette { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
.pal { height: 40px; border-radius: 10px; border: 1.5px solid var(--line-strong); background: var(--surface); font-weight: 800; font-size: 0.85rem; color: var(--ink-2); position: relative; }
.pal.visited { background: var(--bad-50); border-color: var(--bad); color: var(--bad); }
.pal.answered { background: var(--good); border-color: var(--good); color: #fff; }
.pal.marked { background: var(--violet); border-color: var(--violet); color: #fff; border-radius: 50%; }
.pal.marked.ans::after { content: ''; position: absolute; right: 3px; bottom: 3px; width: 9px; height: 9px; border-radius: 50%; background: var(--good); border: 2px solid #fff; }
.pal.current { outline: 3px solid var(--brand); outline-offset: 2px; }
.legend { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.75rem; color: var(--muted); margin: 14px 0; }
.legend span { display: flex; gap: 6px; align-items: center; }
.legend i { width: 16px; height: 16px; border-radius: 5px; border: 1.5px solid var(--line-strong); display: inline-block; }
.cbt-bottom { display: flex; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--line); background: var(--surface); flex-wrap: wrap; }
.cbt-palette-toggle { display: none; }
@media (max-width: 900px) {
  .cbt-body { grid-template-columns: 1fr; }
  .cbt-side { position: fixed; right: 0; top: 0; bottom: 0; width: min(320px, 88vw); z-index: 70; transform: translateX(100%); transition: transform 0.2s ease; box-shadow: var(--shadow-lg); }
  .cbt-side.open { transform: none; }
  .cbt-palette-toggle { display: inline-flex; }
  .cbt-bottom .btn { flex: 1; padding: 0 10px; }
}
.modal-back { position: fixed; inset: 0; background: rgba(8, 12, 30, 0.55); z-index: 80; display: grid; place-items: center; padding: 16px; }
.modal { background: var(--surface); border-radius: 18px; padding: 22px; width: min(460px, 100%); box-shadow: var(--shadow-lg); }

/* Result */
.result-hero { display: grid; grid-template-columns: auto 1fr; gap: 22px; align-items: center; padding: 22px; }
.ring { --p: 0; width: 132px; height: 132px; border-radius: 50%; background: conic-gradient(var(--brand) calc(var(--p) * 1%), var(--surface-2) 0); display: grid; place-items: center; }
.ring div { width: 104px; height: 104px; border-radius: 50%; background: var(--surface); display: grid; place-items: center; text-align: center; }
.ring b { font-size: 1.5rem; line-height: 1; }
@media (max-width: 640px) { .result-hero { grid-template-columns: 1fr; justify-items: center; text-align: center; } }

.empty { text-align: center; padding: 32px 16px; color: var(--muted); }

/* Print = clean PDF of the paper with answers and the Telegram link on every page */
@media print {
  .hdr, .bnav, .ftr, .toolbar, .aside, .paper-actions, .lang-switch, .crumbs, .no-print { display: none !important; }
  body { background: #fff; padding: 0; font-size: 12px; }
  .card { box-shadow: none; border-color: #ddd; break-inside: avoid; }
  .layout { display: block; }
  details.sol > summary { display: none; }
  details.sol:not([open]) > .sol-body { display: block; }
  .print-only { display: block !important; }
  .q { padding: 10px 12px; margin-bottom: 8px; }
}
.print-only { display: none; }

/* refinements after visual QA */
.nav a { white-space: nowrap; }
.hdr-search { width: min(280px, 24vw); }
.logo small { white-space: nowrap; }
@media (max-width: 1400px) { .logo small { display: none; } }
@media (max-width: 1280px) { .nav a { padding: 8px 9px; } }
@media (max-width: 640px) { .phead > .badge-ico { display: none; } .phead { padding: 18px; } }
.hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 32px; align-items: center; }
.qotd { background: #fff; color: #0f172a; border-radius: 18px; padding: 18px; box-shadow: var(--shadow-lg); transform: rotate(1.2deg); }
.qotd .opt { padding: 8px 12px; font-size: 0.92rem; background: #fff; color: #0f172a; border-color: #e4e7f0; }
.qotd .opt .k { background: #f1f3f9; color: #3b4559; }
.qotd .opt.is-correct { background: #e8f8ef; border-color: #12a150; }
.qotd .opt.is-correct .k { background: #12a150; color: #fff; }
@media (max-width: 1000px) { .hero-grid { grid-template-columns: 1fr; } .qotd { display: none; } }
.cbt { grid-template-columns: minmax(0, 1fr); }
.cbt-top .title { min-width: 0; flex: 1; }
.cbt-top .timer { margin-left: 0; }
@media (max-width: 900px) {
  .cbt-body { grid-template-columns: minmax(0, 1fr); }
  .cbt-bottom { display: grid; grid-template-columns: 1fr 1fr; }
  .cbt-bottom .grow { display: none; }
  .cbt-bottom .btn { font-size: 0.85rem; }
}
